<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<Table
		id="itemsTable"
		items="{_Item}"
		noDataText="{i18n>itemsNoData}">
		<columns>
			<Column><Text text="{i18n>colItemNo}" /></Column>
			<Column><Text text="{i18n>colNdc}" /></Column>
			<Column><Text text="{i18n>colDescription}" /></Column>
			<Column><Text text="{i18n>colLot}" /></Column>
			<Column hAlign="End"><Text text="{i18n>colQty}" /></Column>
			<Column><Text text="{i18n>colExisId}" /></Column>
			<Column><Text text="{i18n>colRefundType}" /></Column>
			<Column><Text text="{i18n>colRejectionReason}" /></Column>
			<Column hAlign="End"><Text text="{i18n>colNetAmount}" /></Column>
		</columns>
		<items>
			<!-- HigherLevelItem rows are rendered with a visual indent, display
				only (no child/parent interaction in MVP-1 — prompt §4.3.2). -->
			<ColumnListItem class="{= ${HigherLevelItem} ? 'returnsChildItemRow' : '' }">
				<cells>
					<Text text="{CustomerReturnItem}" />
					<Text text="{Product}" />
					<Text text="{CustomerReturnItemText}" />
					<Text text="{path: 'Batch', formatter: '.formatter.orDash'}" />
					<Text text="{parts: [{path: 'RequestedQuantity'}, {path: 'RequestedQuantityUnit'}], formatter: '.formatter.quantityText'}" />
					<Text text="{path: 'PurchaseOrderByCustomer', formatter: '.formatter.orDash'}" />
					<Text text="{path: '_ReturnsRefundType/ReturnsRefundType_Text', formatter: '.formatter.orDash'}" />
					<Text text="{path: '_SalesDocumentRjcnReason/SalesDocumentRjcnReason_Text', formatter: '.formatter.orDash'}" />
					<Text text="{parts: [{path: 'NetAmount'}, {path: 'TransactionCurrency'}], formatter: '.formatter.netAmountText'}" />
				</cells>
			</ColumnListItem>
		</items>
	</Table>
</core:FragmentDefinition>
