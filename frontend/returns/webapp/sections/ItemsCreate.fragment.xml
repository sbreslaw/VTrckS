<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<!-- Create mode items (prompt §4A.5): each row is a LOCAL scratch object
		(model "createItems") until Product + Quantity are both filled, at which
		point Detail.controller.js#_postCreateItemRow POSTs it (Step-0: an item's
		fields cannot be PATCHed once posted — nav PATCH 501s, absolute PATCH
		404s on the still-blank key, DELETE 400s). A posted row's inputs are
		then disabled in place (createItems>posted) and its Remove button hides —
		there is no supported way to edit/remove a posted-but-unsaved row short
		of Cancel discarding the whole document. -->
	<Panel headerText="{i18n>sectionItems}" expandable="false">
		<Table
			id="createItemsTable"
			items="{createItems>/rows}"
			noDataText="{i18n>createItemsNoData}">
			<columns>
				<Column><Text text="{i18n>colItemNo}" /></Column>
				<Column><Text text="{i18n>colNdc}" /></Column>
				<Column><Text text="{i18n>colDescription}" /></Column>
				<Column><Text text="{i18n>colLot}" /></Column>
				<Column hAlign="End"><Text text="{i18n>colQty}" /></Column>
				<Column><Text text="{i18n>fieldExisId}" /></Column>
				<Column><Text text="{i18n>colRefundType}" /></Column>
				<Column />
			</columns>
			<items>
				<ColumnListItem>
					<cells>
						<Text text="{createItems>itemId}" />
						<Input
							value="{createItems>product}"
							editable="{= !${createItems>posted} }"
							maxLength="18"
							showSuggestion="true"
							suggest=".onCreateItemProductSuggest"
							suggestionItemSelected=".onCreateItemProductSuggestionSelected"
							change=".onCreateItemProductChange" />
						<Text text="{createItems>productName}" />
						<Input value="{createItems>batch}" editable="{= !${createItems>posted} }" maxLength="10" />
						<Input
							value="{createItems>quantity}"
							editable="{= !${createItems>posted} }"
							type="Number"
							textAlign="End"
							change=".onCreateItemQuantityChange" />
						<Input value="{createItems>exisId}" editable="{= !${createItems>posted} }" maxLength="35" />
						<Select
							selectedKey="{createItems>refundType}"
							enabled="{= !${createItems>posted} }"
							forceSelection="false"
							items="{createItems>/refundTypeItems}">
							<core:Item key="{createItems>key}" text="{createItems>text}" />
						</Select>
						<Button
							icon="sap-icon://less"
							type="Transparent"
							tooltip="{i18n>createItemsRemoveRow}"
							visible="{= !${createItems>posted} }"
							press=".onCreateItemRemoveRow" />
					</cells>
				</ColumnListItem>
			</items>
		</Table>
		<Button text="{i18n>createItemsAddRow}" press=".onCreateItemAddRow" class="sapUiTinyMarginTop" />
	</Panel>
</core:FragmentDefinition>
