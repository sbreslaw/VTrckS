<core:FragmentDefinition 
  xmlns="sap.m" 
  xmlns:core="sap.ui.core" 
  xmlns:f="sap.ui.layout.form" 
  xmlns:l="sap.ui.layout">
			<f:Form width="auto" editable="{appView>/editMode}">
				<f:layout>
					<f:ResponsiveGridLayout 
						labelSpanXL="4"
						labelSpanL="4"
						labelSpanM="4"
						labelSpanS="12"
						adjustLabelSpan="false"
						emptySpanXL="0"
						emptySpanL="0"
						emptySpanM="0"
						emptySpanS="0"
						columnsXL="2" 
						columnsL="2" 
						columnsM="1" 
						singleContainerFullSize="false"
					/>
				</f:layout>

				<f:formContainers>
					<f:FormContainer title="{i18n>detailsGeneral}">
						<f:formElements>
							<f:FormElement>
								<f:label>
									<Label text="{i18n>filterRequestId}" required="false">
										<layoutData>
											<l:GridData span="XL4 L4 M4 S12" indent="XL0 L0 M0 S0" linebreak="true"/>
										</layoutData>
									</Label>
								</f:label>

								<f:fields>
                  <Text text="{SalesOrder}" />
								</f:fields>
							</f:FormElement>

							<f:FormElement>
								<f:label>
									<Label text="{i18n>colDescription}" required="false">
										<layoutData>
											<l:GridData span="XL4 L4 M4 S12" indent="XL0 L0 M0 S0" linebreak="true"/>
										</layoutData>
									</Label>
								</f:label>

								<f:fields>
                  <Text text="{SalesOrder}" />
								</f:fields>
							</f:FormElement>

							<f:FormElement>
								<f:label>
									<Label text="{i18n>providerId}" required="false">
										<layoutData>
											<l:GridData span="XL4 L4 M4 S12" indent="XL0 L0 M0 S0" linebreak="true"/>
										</layoutData>
									</Label>
								</f:label>

								<f:fields>
                  <Text text="{SoldToParty}" />
								</f:fields>
							</f:FormElement>

							<f:FormElement>
								<f:label>
									<Label text="{i18n>providerName}" required="false">
										<layoutData>
											<l:GridData span="XL4 L4 M4 S12" indent="XL0 L0 M0 S0" linebreak="true"/>
										</layoutData>
									</Label>
								</f:label>

								<f:fields>
                  <Text text="{CustomerName}" />
								</f:fields>
							</f:FormElement>

							<f:FormElement>
								<f:label>
									<Label text="{i18n>orderType}" required="false">
										<layoutData>
											<l:GridData span="XL4 L4 M4 S12" indent="XL0 L0 M0 S0" linebreak="true"/>
										</layoutData>
									</Label>
								</f:label>

								<f:fields>
                  <Text text="{SalesOrderType}" />
								</f:fields>
							</f:FormElement>

							<f:FormElement>
								<f:label>
									<Label text="{i18n>contact}" required="false">
										<layoutData>
											<l:GridData span="XL4 L4 M4 S12" indent="XL0 L0 M0 S0" linebreak="true"/>
										</layoutData>
									</Label>
								</f:label>

								<f:fields>
                  <Text text="{_SoldToPartyContactInfo/FullName}" />
								</f:fields>
							</f:FormElement>

							<f:FormElement>
								<f:label>
									<Label text="{i18n>shipTo}" required="false">
										<layoutData>
											<l:GridData span="XL4 L4 M4 S12" indent="XL0 L0 M0 S0" linebreak="true"/>
										</layoutData>
									</Label>
								</f:label>

								<f:fields>
                  <Text text="{_SoldToPartyContactInfo/FormattedPostalAddressDesc}" />
								</f:fields>
							</f:FormElement>

							<f:FormElement>
								<f:label>
									<Label text="{i18n>colEmployeeResponsible}" required="false">
										<layoutData>
											<l:GridData span="XL4 L4 M4 S12" indent="XL0 L0 M0 S0" linebreak="true"/>
										</layoutData>
									</Label>
								</f:label>

								<f:fields>
                  <Text text="{_SoldToPartyContactInfo/ResponsibleEmployee}" />
								</f:fields>
							</f:FormElement>

							<f:FormElement>
								<f:label>
									<Label text="{i18n>filterPriority}" required="false">
										<layoutData>
											<l:GridData span="XL4 L4 M4 S12" indent="XL0 L0 M0 S0" linebreak="true"/>
										</layoutData>
									</Label>
								</f:label>

								<f:fields>
                  <Text text="{= '\u2014'}" />
								</f:fields>
							</f:FormElement>

							<f:FormElement>
								<f:label>
									<Label text="{i18n>otherReason}" required="false">
										<layoutData>
											<l:GridData span="XL4 L4 M4 S12" indent="XL0 L0 M0 S0" linebreak="true"/>
										</layoutData>
									</Label>
								</f:label>

								<f:fields>
                  <Text text="{_SDDocumentReason/SDDocumentReason_Text}" />
								</f:fields>
							</f:FormElement>

							<f:FormElement>
								<f:label>
									<Label text="{i18n>category}" required="false">
										<layoutData>
											<l:GridData span="XL4 L4 M4 S12" indent="XL0 L0 M0 S0" linebreak="true"/>
										</layoutData>
									</Label>
								</f:label>

								<f:fields>
                  <Text text="{= '\u2014'}" />
								</f:fields>
							</f:FormElement>

							<f:FormElement>
								<f:label>
									<Label text="{i18n>colStatus}" required="false">
										<layoutData>
											<l:GridData span="XL4 L4 M4 S12" indent="XL0 L0 M0 S0" linebreak="true"/>
										</layoutData>
									</Label>
								</f:label>

								<f:fields>
                  <Text text="{path: 'UserStatusDerived', formatter: '.formatter.detailStatusText'}" />
								</f:fields>
							</f:FormElement>

							<f:FormElement>
								<f:label>
									<Label text="{i18n>filterExisId}" required="false">
										<layoutData>
											<l:GridData span="XL4 L4 M4 S12" indent="XL0 L0 M0 S0" linebreak="true"/>
										</layoutData>
									</Label>
								</f:label>

								<f:fields>
                  <Text text="{PurchaseOrderByCustomer}" />
								</f:fields>
							</f:FormElement>


            </f:formElements>
          </f:FormContainer>

<!-- DATES -->

					<f:FormContainer title="{i18n>detailsDates}">
						<f:formElements>
							<f:FormElement>
								<f:label>
									<Label text="{i18n>colCreatedAt}" required="false">
										<layoutData>
											<l:GridData span="XL4 L4 M4 S12" indent="XL0 L0 M0 S0" linebreak="true"/>
										</layoutData>
									</Label>
								</f:label>
 								<f:fields>
                  <Text text="{path: 'CreationDate'}" />
								</f:fields>

              </f:FormElement>
            </f:formElements>
          </f:FormContainer>

<!-- VALUES -->

					<f:FormContainer title="{i18n>detailsValue}">
						<f:formElements>
							<f:FormElement>
								<f:label>
									<Label text="{i18n>netValue}" required="false">
										<layoutData>
											<l:GridData span="XL4 L4 M4 S12" indent="XL0 L0 M0 S0" linebreak="true"/>
										</layoutData>
									</Label>
								</f:label>
 								<f:fields>
                  <ObjectNumber number="{TotalNetAmount}" unit="{TransactionCurrency}" />
								</f:fields>

              </f:FormElement>

							<f:FormElement>
								<f:label>
									<Label text="{i18n>taxAmount}" required="false">
										<layoutData>
											<l:GridData span="XL4 L4 M4 S12" indent="XL0 L0 M0 S0" linebreak="true"/>
										</layoutData>
									</Label>
								</f:label>
 								<f:fields>
                  <Text text="{= '\u2014'}" />
                  <!-- <ObjectNumber number="{TotalNetAmount}" unit="{TransactionCurrency}" /> -->
								</f:fields>

              </f:FormElement>

							<f:FormElement>
								<f:label>
									<Label text="{i18n>grossValue}" required="false">
										<layoutData>
											<l:GridData span="XL4 L4 M4 S12" indent="XL0 L0 M0 S0" linebreak="true"/>
										</layoutData>
									</Label>
								</f:label>
 								<f:fields>
                  <Text text="{= '\u2014'}" />
                  <!-- <ObjectNumber number="{TotalNetAmount}" unit="{TransactionCurrency}" /> -->
								</f:fields>

              </f:FormElement>


            </f:formElements>
          </f:FormContainer>


        </f:formContainers>
      </f:Form>

</core:FragmentDefinition>
