					</f:FormElement>

				</f:formElements>
			</f:FormContainer> -->

<!-- NOTES -->

			<f:FormContainer title="{i18n>detailsNotes}">
				<!-- Full row; label/field spans halved so they align with the half-width containers above. -->
				<f:layoutData>
					<l:GridData span="XL12 L12 M12 S12" linebreak="true"/>
				</f:layoutData>
				<f:formElements>
					<f:FormElement>
						<!-- <f:label>
							<Label text="{i18n>detailsNotes}" required="false">
								<layoutData>
									<l:GridData span="XL2 L2 M4 S12" linebreak="true"/>
								</layoutData>
							</Label>
						</f:label> -->

						<f:fields>
						<!-- Header notes map to _Text/LongText for ZVRH. The local model
							buffers the value until Create Save or Details section Save. -->
						<TextArea rows="3" width="100%"
							value="{createEnrich>/notes}"
							editable="{= ${sectionFlags>/createMode} || ${sectionFlags>/details/editing} }">
							<layoutData>
								<l:GridData span="XL12 L12 M12 S12"/>
							</layoutData>
						</TextArea>
						</f:fields>
					</f:FormElement>
				</f:formElements>
			</f:FormContainer>

<!-- VALUES -->

