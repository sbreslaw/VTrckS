<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
  <!-- v5 Required Fix 4: adding a new editable createMode field here requires
       adding it to ServiceSchema.updatableHeaderProperties -
       createReplayHeaderProperties is auto-derived from that list, see
       ServiceSchema.js. -->
  <f:SimpleForm editable="{sectionFlags>/orgData/editing}" layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" columnsL="2" columnsM="2">
    <f:content>
      <Label text="{i18n>salesOrg}" />
      <!-- read-only outside createMode: backend rejects PATCH with "Read-only
           fields must not be changed" on an existing order (confirmed
           2026-08-21) - these three are creatable-only, so the ComboBox below
           checks /createMode directly, not /orgData/editing (unlike
           SalesOffice/SalesGroup, which stay editable in normal edit sessions
           too). Entity sets + Text properties confirmed in design/so.xml
           (SalesOrganizationType/DistributionChannelType/OrganizationDivisionType). -->
      <Text text="{_SalesOrganization/SalesOrganization_Text}" visible="{= !${sectionFlags>/createMode} }" />
      <!-- Fix 1 (Corrective Work Order): no longer user input in createMode -
           this is one of the sales-area constants CreateWithSalesOrderType
           sends (ServiceSchema.salesArea, TODO-VERIFY(B4)); fixed by the
           action, read-only here. -->
      <Text text="{SalesOrganization}" visible="{sectionFlags>/createMode}" />
      <Label text="{i18n>distributionChannel}" />
      <Text text="{_DistributionChannel/DistributionChannel_Text}" visible="{= !${sectionFlags>/createMode} }" />
      <Text text="{DistributionChannel}" visible="{sectionFlags>/createMode}" />
      <Label text="{i18n>division}" />
      <Text text="{_OrganizationDivision/Division_Text}" visible="{= !${sectionFlags>/createMode} }" />
      <Text text="{OrganizationDivision}" visible="{sectionFlags>/createMode}" />
      <Label text="{i18n>salesOffice}" />
      <Text text="{_SalesOffice/SalesOffice_Text}" visible="{= !${sectionFlags>/orgData/editing} }" />
      <ComboBox
        selectedKey="{SalesOffice}"
        visible="{sectionFlags>/orgData/editing}"
        enabled="{= !${sectionFlags>/createMode} || ${createState>/providerChosen} }"
        items="{path: '/SalesOffice'}">
        <core:Item key="{SalesOffice}" text="{SalesOffice_Text}" />
      </ComboBox>
      <Label text="{i18n>salesGroup}" />
      <Text text="{_SalesGroup/SalesGroup_Text}" visible="{= !${sectionFlags>/orgData/editing} }" />
      <ComboBox
        selectedKey="{SalesGroup}"
        visible="{sectionFlags>/orgData/editing}"
        enabled="{= !${sectionFlags>/createMode} || ${createState>/providerChosen} }"
        items="{path: '/SalesGroup'}">
        <core:Item key="{SalesGroup}" text="{SalesGroup_Text}" />
      </ComboBox>
      <Label text="{i18n>serviceOrgUnit}" />
      <Text text="{= '\u2014'}" />
      <Label text="{i18n>serviceOrganization}" />
      <Text text="{= '\u2014'}" />
    </f:content>
  </f:SimpleForm>
</core:FragmentDefinition>
