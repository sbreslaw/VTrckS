<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
  <!-- CRUD Task 1 v3 (In-Place Create, design/prompts/CRUD Task 1 Prompt v3.md):
       new section, always read-only. Partners are determined by the backend
       from the Provider (SoldToParty) - there is no per-partner write entity
       exposed by this service, so editing individual partners stays a
       separate, not-yet-scoped feature (see OPEN_QUESTIONS.md). Renders the
       same partner fields already confirmed safe to read on the Detail page
       (ServiceSchema.js contactProperties/shipToPartyProperties). -->
  <f:SimpleForm layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" columnsL="2" columnsM="2">
    <f:content>
      <Label text="{i18n>shipTo}" />
      <Text text="{_ShipToParty/FullName}" />
      <Label text="{i18n>colEmployeeResponsible}" />
      <Text text="{_SoldToPartyContactInfo/ResponsibleEmployee}" />
      <Label text="{i18n>partiesInvolvedPayer}" />
      <Text text="{_SoldToPartyContactInfo/PayerParty}" />
      <Label text="{i18n>partiesInvolvedBillTo}" />
      <Text text="{_SoldToPartyContactInfo/BillToParty}" />
    </f:content>
  </f:SimpleForm>
  <MessageStrip text="{i18n>partiesInvolvedNote}" type="Information" showIcon="true" visible="{sectionFlags>/createMode}" class="sapUiTinyMarginTop" />
</core:FragmentDefinition>
