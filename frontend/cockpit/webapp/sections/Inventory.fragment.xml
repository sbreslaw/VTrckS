<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <!-- Edit List loads provider inventory from po>/ProviderIOH. The service
      requires a SoldToParty filter, so loading is owned by
      Detail.controller.js#_loadProviderInventory rather than a direct XML
      list binding. Quantity is the only editable field. -->
  <VBox>
    <items>
      <Table id="iohTable" items="{ioh>/rows}" busy="{ioh>/busy}"
        noDataText="{= ${ioh>/error} ? ${i18n>inventoryLoadError} : ${i18n>inventoryNoRows} }">
        <headerToolbar>
          <OverflowToolbar>
            <Button text="{i18n>iohInsert}" type="Transparent" visible="{sectionFlags>/createMode}"
              enabled="{ioh>/editable}" press=".onInventoryInsertRow" />
            <ToolbarSpacer />
            <Label text="{i18n>iohFilter}" labelFor="iohFilter" />
            <SearchField id="iohFilter" width="15rem" liveChange=".onInventoryFilter" />
          </OverflowToolbar>
        </headerToolbar>
        <columns>
          <Column width="5rem" visible="{sectionFlags>/createMode}"><Text text="{i18n>iohActions}" /></Column>
          <Column><Text text="{i18n>iohBrand}" /></Column>
          <Column><Text text="{i18n>iohNdcCode}" /></Column>
          <Column><Text text="{i18n>iohLotNumber}" /></Column>
          <Column hAlign="End"><Text text="{i18n>iohQuantity}" /></Column>
          <Column><Text text="{i18n>iohExpiration}" /></Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <Button icon="sap-icon://delete" type="Transparent" visible="{sectionFlags>/createMode}" enabled="{ioh>/editable}"
                tooltip="{i18n>iohDeleteRow}" press=".onInventoryDeleteRow" />
              <Text text="{ioh>brand}" />
              <VBox>
                <Text text="{ioh>ndc}" visible="{= !${ioh>isNew} }" />
                <Input value="{ioh>ndc}" visible="{ioh>isNew}" showValueHelp="true"
                  editable="{ioh>/editable}" valueHelpRequest=".onInventoryNdcValueHelpRequest" />
              </VBox>
              <VBox>
                <Text text="{ioh>lot}" visible="{= !${ioh>isNew} }" />
                <Input value="{ioh>lot}" visible="{ioh>isNew}" editable="{ioh>/editable}" />
              </VBox>
              <Input value="{ioh>quantity}" type="Number" textAlign="End"
                editable="{= ${sectionFlags>/createMode} &amp;&amp; ${ioh>/editable} }" />
              <VBox>
                <Text text="{ioh>expirationDate}" visible="{= !${ioh>isNew} }" />
                <DatePicker value="{ioh>expirationDate}" valueFormat="MM/dd/yyyy" displayFormat="MM/dd/yyyy"
                  visible="{ioh>isNew}" editable="{ioh>/editable}" />
              </VBox>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </items>
  </VBox>
</core:FragmentDefinition>
