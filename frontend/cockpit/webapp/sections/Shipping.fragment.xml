<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
  <f:SimpleForm editable="false" layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" columnsL="2" columnsM="2">
    <f:content>
      <Label text="{i18n>shipTo}" />
      <Text text="{ShipToParty}" />
      <Label text="{i18n>customerReference}" />
      <Text text="{CustomerPurchaseOrderNumber}" />
      <Label text="{i18n>shippingCondition}" />
      <Text text="{ShippingCondition}" />
      <Label text="{i18n>deliveryStatus}" />
      <Text text="{OverallDeliveryStatus}" />
    </f:content>
  </f:SimpleForm>
</core:FragmentDefinition>
