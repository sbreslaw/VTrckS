<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form"
  xmlns:l="sap.ui.layout">
  <!-- Item Details view session prompt, 3.3.1 (details.png). Display-first:
       every field here is read-only this phase (no `editing` key exists in
       the itemSectionFlags model for this section - the panel's Edit button
       is the standard disabled "later phase" placeholder, SectionFactory.js). -->
  <f:Form width="auto" editable="false">
    <f:layout>
      <f:ResponsiveGridLayout
        labelSpanXL="4"
        labelSpanL="4"
        labelSpanM="4"
        labelSpanS="12"
        adjustLabelSpan="false"
        emptySpanXL="0"
        emptySpanL="0"
        emptySpanM="0"
        emptySpanS="0"
        columnsXL="2"
        columnsL="2"
        columnsM="1"
        singleContainerFullSize="false"
      />
    </f:layout>

    <f:formContainers>
      <f:FormContainer title="{i18n>detailsGeneral}">
        <f:formElements>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>itemDetailProductId}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <Text text="{Product}">
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </Text>
            </f:fields>
          </f:FormElement>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>itemDetailProduct}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <Text text="{_Product/Product_Text}">
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </Text>
            </f:fields>
          </f:FormElement>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>itemQty}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <Text text="{RequestedQuantity}">
                <layoutData><l:GridData span="XL4 L4 M4 S12"/></layoutData>
              </Text>
              <Text text="{RequestedQuantityUnit}">
                <layoutData><l:GridData span="XL4 L4 M4 S12"/></layoutData>
              </Text>
            </f:fields>
          </f:FormElement>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>colRejectionReason}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <!-- "VH-shaped control rendered disabled - display value only this
                   phase" (session prompt 3.3.1) - real top-level fixed-values
                   EntitySet (so.xml line 2538, ServiceSchema.entitySets is not
                   extended for this since it's read-only VH-shape only here). -->
              <ComboBox selectedKey="{SalesDocumentRjcnReason}" enabled="false"
                items="{path: '/SalesDocumentRjcnReason'}">
                <core:Item key="{SalesDocumentRjcnReason}" text="{SalesDocumentRjcnReason_Text}" />
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </ComboBox>
            </f:fields>
          </f:FormElement>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>colStatus}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <!-- Item-level SDProcessStatus - a different code set from the
                   header's OverallSDProcessStatus/UserStatusDerived; its own
                   Text navigation gives the label directly, no client-side
                   status-code map (ServiceSchema.js itemDetailProperties.status). -->
              <Text text="{path: '_SDProcessStatus/SDProcessStatus_Text', formatter: '.formatter.orDash'}">
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </Text>
            </f:fields>
          </f:FormElement>

        </f:formElements>
      </f:FormContainer>

      <f:FormContainer title="{i18n>itemDetailReferences}">
        <f:formElements>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>colOrderIntention}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <Text text="{path: 'MaterialGroup1', formatter: '.formatter.orDash'}">
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </Text>
            </f:fields>
          </f:FormElement>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>colFundType}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <Text text="{path: 'MaterialGroup2', formatter: '.formatter.orDash'}">
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </Text>
            </f:fields>
          </f:FormElement>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>colPoReference}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <!-- Same underlying field as the Items grid's ExIS Item Number
                   column (ServiceSchema.itemDetailProperties.poReference). -->
              <Text text="{path: 'PurchaseOrderByCustomer', formatter: '.formatter.orDash'}">
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </Text>
            </f:fields>
          </f:FormElement>

        </f:formElements>
      </f:FormContainer>

      <f:FormContainer title="{i18n>itemDetailShippingAndBilling}">
        <f:formElements>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>colDeliveryStatus}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <Text text="{path: '_DeliveryStatus/DeliveryStatus_Text', formatter: '.formatter.orDash'}">
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </Text>
            </f:fields>
          </f:FormElement>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>itemDetailTotalQtyDelivered}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <Text text="{ConfdDelivQtyInOrderQtyUnit}">
                <layoutData><l:GridData span="XL4 L4 M4 S12"/></layoutData>
              </Text>
              <Text text="{OrderQuantityUnit}">
                <layoutData><l:GridData span="XL4 L4 M4 S12"/></layoutData>
              </Text>
            </f:fields>
          </f:FormElement>

        </f:formElements>
      </f:FormContainer>

      <f:FormContainer title="{i18n>itemDetailItemValue}">
        <f:formElements>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>itemDetailNetPricePerUnit}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <!-- TODO-VERIFY(net-price-per-unit) - no per-unit price field
                   exists on this entity (ServiceSchema.itemDetailProperties.
                   netPricePerUnit is null, see so.xml Step-0 finding). -->
              <Text text="{= '\u2014'}" tooltip="{i18n>itemDetailPendingFieldTooltip}">
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </Text>
            </f:fields>
          </f:FormElement>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>netValue}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <ObjectNumber number="{path: 'NetAmount', formatter: '.formatter.detailNetValue'}"
                unit="{path: 'TransactionCurrency', formatter: '.formatter.detailCurrency'}">
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </ObjectNumber>
            </f:fields>
          </f:FormElement>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>grossValue}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <!-- No item-level Gross field exists (ZZ_GROSS_VALUE_SDH is
                   header-only) - computed client-side as Net + Tax
                   (formatter.itemDetailGrossValue), same pattern already used
                   for the header's virtual Tax Amount. -->
              <ObjectNumber number="{parts: [{path: 'NetAmount'}, {path: 'TaxAmount'}], formatter: '.formatter.itemDetailGrossValue'}"
                unit="{path: 'TransactionCurrency', formatter: '.formatter.detailCurrency'}">
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </ObjectNumber>
            </f:fields>
          </f:FormElement>

        </f:formElements>
      </f:FormContainer>

      <f:FormContainer title="{i18n>detailsNotes}">
        <f:formElements>
          <f:FormElement>
            <f:fields>
              <!-- Item text write path is a later backend task (session prompt
                   3.3.1) - _ItemText/ItemTextType exists in so.xml (real
                   collection) but is not read here this phase either, matching
                   the disabled/pending idiom used elsewhere (Attachments,
                   PaymentMethod CVV). -->
              <TextArea enabled="false" rows="3" width="100%" tooltip="{i18n>itemDetailNotesPendingTooltip}"
                placeholder="{i18n>itemDetailNotesPendingTooltip}">
                <layoutData><l:GridData span="XL12 L12 M12 S12"/></layoutData>
              </TextArea>
            </f:fields>
          </f:FormElement>
        </f:formElements>
      </f:FormContainer>

    </f:formContainers>
  </f:Form>
</core:FragmentDefinition>
