<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form"
  xmlns:l="sap.ui.layout">
  <!-- ret-10-28 #5: profile variant (SectionFactory.js) - identical to the
       shared ItemDetails.fragment.xml except for 4 literal-binding hazards
       confirmed absent on CustomerReturnItemManageType (ui_customerreturnmanage
       2026-10-28 metadata): _SDProcessStatus nav, MaterialGroup1/2,
       _DeliveryStatus nav, ConfdDelivQtyInOrderQtyUnit/OrderQuantityUnit -
       all swapped for the same dash/TODO-VERIFY placeholder idiom already
       used in the shared fragment for netPricePerUnit. Diff against that file
       whenever it changes. -->
  <f:Form width="auto" editable="false">
    <f:layout>
      <f:ResponsiveGridLayout
        labelSpanXL="4"
        labelSpanL="4"
        labelSpanM="4"
        labelSpanS="12"
        adjustLabelSpan="false"
        emptySpanXL="0"
        emptySpanL="0"
        emptySpanM="0"
        emptySpanS="0"
        columnsXL="2"
        columnsL="2"
        columnsM="1"
        singleContainerFullSize="false"
      />
    </f:layout>

    <f:formContainers>
      <f:FormContainer title="{i18n>detailsGeneral}">
        <f:formElements>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>itemDetailProductId}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <Text text="{Product}">
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </Text>
            </f:fields>
          </f:FormElement>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>itemDetailProduct}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <Text text="{_Product/Product_Text}">
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </Text>
            </f:fields>
          </f:FormElement>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>itemQty}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <Text text="{RequestedQuantity}">
                <layoutData><l:GridData span="XL4 L4 M4 S12"/></layoutData>
              </Text>
              <Text text="{RequestedQuantityUnit}">
                <layoutData><l:GridData span="XL4 L4 M4 S12"/></layoutData>
              </Text>
            </f:fields>
          </f:FormElement>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>colRejectionReason}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <Text text="{path: '_SalesDocumentRjcnReason/SalesDocumentRjcnReason_Text', formatter: '.formatter.orDash'}">
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </Text>
            </f:fields>
          </f:FormElement>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>colStatus}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <!-- ret-10-28 #5: no _SDProcessStatus nav exists on
                   CustomerReturnItemManageType (ReturnsSchema.itemDetailProperties.
                   status/statusText are both null) - no equivalent item-level
                   status concept confirmed on this service. -->
              <Text text="{= '\u2014'}" tooltip="{i18n>itemDetailPendingFieldTooltip}">
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </Text>
            </f:fields>
          </f:FormElement>

        </f:formElements>
      </f:FormContainer>

      <f:FormContainer title="{i18n>itemDetailReferences}">
        <f:formElements>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>colOrderIntention}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <!-- ret-10-28 #5: MaterialGroup1 absent on this service
                   (ReturnsSchema.itemDetailProperties.orderIntention is null). -->
              <Text text="{= '\u2014'}" tooltip="{i18n>itemDetailPendingFieldTooltip}">
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </Text>
            </f:fields>
          </f:FormElement>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>colFundType}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <!-- ret-10-28 #5: MaterialGroup2 absent on this service
                   (ReturnsSchema.itemDetailProperties.fundType is null). -->
              <Text text="{= '\u2014'}" tooltip="{i18n>itemDetailPendingFieldTooltip}">
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </Text>
            </f:fields>
          </f:FormElement>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>colPoReference}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <Text text="{path: 'PurchaseOrderByCustomer', formatter: '.formatter.orDash'}">
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </Text>
            </f:fields>
          </f:FormElement>

        </f:formElements>
      </f:FormContainer>

      <f:FormContainer title="{i18n>itemDetailShippingAndBilling}">
        <f:formElements>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>colDeliveryStatus}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <!-- ret-10-28 #5: no _DeliveryStatus nav/Text on this service -
                   DeliveryStatus itself IS a real plain property (raw code,
                   no Text annotation, confirmed 2026-10-28 metadata). -->
              <Text text="{path: 'DeliveryStatus', formatter: '.formatter.orDash'}">
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </Text>
            </f:fields>
          </f:FormElement>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>itemDetailTotalQtyDelivered}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <!-- ret-10-28 #5: ConfdDelivQtyInOrderQtyUnit/OrderQuantityUnit
                   both absent on this service (ReturnsSchema.itemDetailProperties.
                   totalQtyDelivered/orderQuantityUnit are both null). -->
              <Text text="{= '\u2014'}" tooltip="{i18n>itemDetailPendingFieldTooltip}">
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </Text>
            </f:fields>
          </f:FormElement>

        </f:formElements>
      </f:FormContainer>

      <f:FormContainer title="{i18n>itemDetailItemValue}">
        <f:formElements>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>itemDetailNetPricePerUnit}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <Text text="{= '\u2014'}" tooltip="{i18n>itemDetailPendingFieldTooltip}">
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </Text>
            </f:fields>
          </f:FormElement>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>netValue}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <ObjectNumber number="{path: 'NetAmount', formatter: '.formatter.detailNetValue'}"
                unit="{path: 'TransactionCurrency', formatter: '.formatter.detailCurrency'}">
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </ObjectNumber>
            </f:fields>
          </f:FormElement>

          <f:FormElement>
            <f:label>
              <Label text="{i18n>grossValue}">
                <layoutData><l:GridData span="XL4 L4 M4 S12" linebreak="true"/></layoutData>
              </Label>
            </f:label>
            <f:fields>
              <ObjectNumber number="{parts: [{path: 'NetAmount'}, {path: 'TaxAmount'}], formatter: '.formatter.itemDetailGrossValue'}"
                unit="{path: 'TransactionCurrency', formatter: '.formatter.detailCurrency'}">
                <layoutData><l:GridData span="XL8 L8 M8 S12"/></layoutData>
              </ObjectNumber>
            </f:fields>
          </f:FormElement>

        </f:formElements>
      </f:FormContainer>

      <f:FormContainer title="{i18n>detailsNotes}">
        <f:formElements>
          <f:FormElement>
            <f:fields>
              <TextArea enabled="false" rows="3" width="100%" tooltip="{i18n>itemDetailNotesPendingTooltip}"
                placeholder="{i18n>itemDetailNotesPendingTooltip}">
                <layoutData><l:GridData span="XL12 L12 M12 S12"/></layoutData>
              </TextArea>
            </f:fields>
          </f:FormElement>
        </f:formElements>
      </f:FormContainer>

    </f:formContainers>
  </f:Form>
</core:FragmentDefinition>
