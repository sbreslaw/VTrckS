<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <!-- ADR-002 returns variant of PartiesInvolved.fragment.xml (loaded by
       SectionFactory.js#_loadFragment for profileId "returns"; shown on every
       return type but not in create mode, OrderModeConfig.js). Read-only: no row
       actions, no Add/Change/Delete, no createMode note. Rows = the header's
       `_Partner` navigation (HeaderPartnerType, ui_customerreturnmanage_2026-11-09.xml).
       Partner ID, Address and Main Partner are formatter.js rules
       (partnerId, partnerAddress, mainPartnerText); Main Partner = the Sold-To
       function from ReturnsSchema.partnerFunctions (code-owner decision,
       2026-11-11 - the service has no main-partner flag). -->
  <Table id="partiesTable" items="{_Partner}" growing="true" growingThreshold="20">
    <columns>
      <Column><Text text="{i18n>colPartnerFunction}" /></Column>
      <Column><Text text="{i18n>colPartnerId}" /></Column>
      <Column><Text text="{i18n>colPartnerName}" /></Column>
      <Column><Text text="{i18n>colPartnerAddress}" /></Column>
      <Column><Text text="{i18n>colMainPartner}" /></Column>
      <Column><Text text="{i18n>colPartnerEmail}" /></Column>
      <Column><Text text="{i18n>colPartnerPhone}" /></Column>
      <Column><Text text="{i18n>colPartnerFax}" /></Column>
      <Column><Text text="{i18n>colPartnerMobile}" /></Column>
    </columns>
    <items>
      <ColumnListItem>
        <cells>
          <Text text="{_PartnerFunction/PartnerFunction_Text}" />
          <Text text="{parts: [{path: 'Customer'}, {path: 'Supplier'}, {path: 'Personnel'}, {path: 'ContactPerson'}], formatter: '.formatter.partnerId'}" />
          <Text text="{FullName}" />
          <Text text="{parts: [{path: 'StreetName'}, {path: 'HouseNumber'}, {path: 'CityName'}, {path: 'PostalCode'}, {path: 'Country'}, {path: 'FormattedPostalAddressDesc'}], formatter: '.formatter.partnerAddress'}" />
          <Text text="{parts: [{path: 'PartnerFunction'}, {path: 'i18n>valueYes'}, {path: 'i18n>valueNo'}], formatter: '.formatter.mainPartnerText'}" />
          <Text text="{EmailAddress}" />
          <Text text="{InternationalPhoneNumber}" />
          <Text text="{InternationalFaxNumber}" />
          <Text text="{InternationalMobilePhoneNumber}" />
        </cells>
      </ColumnListItem>
    </items>
  </Table>
</core:FragmentDefinition>
