<core:FragmentDefinition 
  xmlns="sap.m" 
  xmlns:core="sap.ui.core" 
  xmlns:f="sap.ui.layout.form" 
	xmlns:l="sap.ui.layout">
	<!-- ret-10-28 #1: _RET-specific Shipping variant (section title "Shipping
			Assignment" on returns - SectionCatalog.js titleKeyByProfile). Fields, in
			order (code owner, 2026-11-12): Provider, Provider Address, Delivery
			Status, Delivery Block Status, Shipping Condition.
			- Delivery Status: the header roll-up of the items' DeliveryStatus,
				_OverallDeliveryStatus/OverallDeliveryStatus_Text (same binding as the
				orders Shipping form; ui_customerreturnmanage_2026-11-12.xml). A new
				return has none yet - the transient create context shows a dash.
			- Delivery Block shows the raw DeliveryBlockReason code only - this
				service has NO Text annotation/ValueListReferences for it (confirmed
				live, 2026-10-28 metadata), unlike orders' _OverallDeliveryBlockStatus/
				OverallDeliveryBlockStatus_Text nav.
			- Shipping Condition is shown here AND in sections/returns/Details.fragment.xml
				(code owner: both), with the same per-type flag
				(orderUi>/fields/detailsShippingCondition: ZKR only) and the same
				editable rule; ShippingCondition is in ReturnsSchema.updatableHeaderProperties. -->
	<f:Form width="auto" editable="{sectionFlags>/shipping/editing}">
		<f:layout>
			<f:ResponsiveGridLayout 
				labelSpanXL="4"
				labelSpanL="4"
				labelSpanM="4"
				labelSpanS="12"
				adjustLabelSpan="false"
				emptySpanXL="0"
				emptySpanL="0"
				emptySpanM="0"
				emptySpanS="0"
				columnsXL="2" 
				columnsL="2" 
				columnsM="1" 
				singleContainerFullSize="true"
			/>
		</f:layout>

		<f:formContainers>
			<f:FormContainer>
				<f:formElements>

					<f:FormElement>
						<f:label>
							<Label text="{i18n>shippingProvider}">
								<layoutData>
									<l:GridData span="XL4 L4 M4 S12" linebreak="true"/>
								</layoutData>
							</Label>
						</f:label>
						<f:fields>
							<Text text="{_ShipToParty/FullName}" visible="{= !${sectionFlags>/createMode} &amp;&amp; !${sectionFlags>/shipping/editing} }">
								<layoutData>
									<l:GridData span="XL8 L8 M8 S12"/>
								</layoutData>
							</Text>
							<Input
								value="{shippingEdit>/providerName}"
								showValueHelp="true"
								visible="{= !${sectionFlags>/createMode} &amp;&amp; ${sectionFlags>/shipping/editing} }"
								valueHelpRequest=".onShippingProviderValueHelpRequest">
								<layoutData>
									<l:GridData span="XL8 L8 M8 S12"/>
								</layoutData>
							</Input>
							<Input
								value="{path: 'createEnrich>/providerName', mode: 'sap.ui.model.BindingMode.OneWay'}"
								showValueHelp="true"
								showSuggestion="true"
								filterSuggests="false"
								startSuggestion="2"
								visible="{sectionFlags>/createMode}"
								valueHelpRequest=".onProviderValueHelpRequest"
								suggest=".onProviderSuggest"
								suggestionItemSelected=".onProviderSuggestionSelected"
								change=".onProviderChange"
								tooltip="{i18n>providerLockedTooltip}">
								<layoutData>
									<l:GridData span="XL8 L8 M8 S12"/>
								</layoutData>
							</Input>
						</f:fields>
					</f:FormElement>

					<f:FormElement>
						<f:label>
							<Label text="{i18n>providerAddress}">
								<layoutData>
									<l:GridData span="XL4 L4 M4 S12" linebreak="true"/>
								</layoutData>
							</Label>
						</f:label>
						<f:fields>
							<Text text="{_ShipToParty/FormattedPostalAddressDesc}" visible="{= !${sectionFlags>/createMode} &amp;&amp; !${sectionFlags>/shipping/editing} }">
								<layoutData>
									<l:GridData span="XL8 L8 M8 S12"/>
								</layoutData>
							</Text>
							<ComboBox
								selectedKey="{_ShipToParty/AddressID}"
								busy="{shippingEdit>/busy}"
								visible="{= !${sectionFlags>/createMode} &amp;&amp; ${sectionFlags>/shipping/editing} }"
								items="{shippingEdit>/addresses}">
								<core:Item key="{shippingEdit>id}" text="{shippingEdit>address}"/>
								<layoutData>
									<l:GridData span="XL8 L8 M8 S12"/>
								</layoutData>
							</ComboBox>
							<ComboBox
								selectedKey="{shippingEdit>/createAddressKey}"
								busy="{shippingEdit>/busy}"
								enabled="{createState>/providerChosen}"
								visible="{sectionFlags>/createMode}"
								selectionChange=".onCreateShippingAddressChange"
								items="{shippingEdit>/addresses}">
								<core:Item key="{shippingEdit>id}" text="{shippingEdit>address}"/>
								<layoutData>
									<l:GridData span="XL8 L8 M8 S12"/>
								</layoutData>
							</ComboBox>
						</f:fields>
					</f:FormElement>

					<f:FormElement>
						<f:label>
							<Label text="{i18n>deliveryStatus}">
								<layoutData>
									<l:GridData span="XL4 L4 M4 S12" linebreak="true"/>
								</layoutData>
							</Label>
						</f:label>
						<f:fields>
							<Text text="{path: '_OverallDeliveryStatus/OverallDeliveryStatus_Text', formatter: '.formatter.orDash'}">
								<layoutData>
									<l:GridData span="XL8 L8 M8 S12"/>
								</layoutData>
							</Text>
						</f:fields>
					</f:FormElement>

					<f:FormElement>
						<f:label>
							<Label text="{i18n>deliveryBlockStatus}">
								<layoutData>
									<l:GridData span="XL4 L4 M4 S12" linebreak="true"/>
								</layoutData>
							</Label>
						</f:label>
						<f:fields>
							<Text text="{DeliveryBlockReason}">
								<layoutData>
									<l:GridData span="XL8 L8 M8 S12"/>
								</layoutData>
							</Text>
						</f:fields>
					</f:FormElement>

					<f:FormElement visible="{orderUi>/fields/detailsShippingCondition/visible}">
						<f:label>
							<Label text="{i18n>shippingCondition}">
								<layoutData>
									<l:GridData span="XL4 L4 M4 S12" linebreak="true"/>
								</layoutData>
							</Label>
						</f:label>
						<f:fields>
							<Text text="{_ShippingCondition/ShippingCondition_Text}" visible="{= !${sectionFlags>/shipping/editing} }">
								<layoutData>
									<l:GridData span="XL8 L8 M8 S12"/>
								</layoutData>
							</Text>
							<ComboBox
								selectedKey="{ShippingCondition}"
								visible="{sectionFlags>/shipping/editing}"
								editable="{= ${orderUi>/fields/detailsShippingCondition/editable} !== false }"
								enabled="{= !${sectionFlags>/createMode} || ${createState>/providerChosen} }"
								items="{path: '/ShippingCondition'}">
								<core:Item key="{ShippingCondition}" text="{ShippingCondition_Text}" />
								<layoutData>
									<l:GridData span="XL8 L8 M8 S12"/>
								</layoutData>
							</ComboBox>
						</f:fields>
					</f:FormElement>

				</f:formElements>
			</f:FormContainer>
		</f:formContainers>
	</f:Form>
</core:FragmentDefinition>
