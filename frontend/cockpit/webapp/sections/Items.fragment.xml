<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <!-- CRUD Task 1 v3 (In-Place Create): the update group for this nested
       "_Item" navigation must match the header context's own group (edit
       session vs. transient create), which XML binding parameters can't
       express conditionally - no $$updateGroupId is declared here at all;
       Detail.controller.js#_rebindItemsGroup rebinds it (with the right
       literal group id) the first time this fragment's content loads, for
       both the "detail" and "create" routes. -->
  <Table id="itemsTable" items="{_Item}" growing="true" growingThreshold="20">
    <headerToolbar>
      <OverflowToolbar>
        <ToolbarSpacer />
        <Button text="{i18n>editAddItem}" icon="sap-icon://add" visible="{sectionFlags>/items/editing}"
          enabled="{= !${sectionFlags>/createMode} || ${createState>/providerChosen} }" press=".onItemsAddRow" />
        <Button text="{i18n>itemsExport}" icon="sap-icon://excel-attachment" press=".onItemsExport" />
        <Button text="{i18n>itemsPersonalize}" icon="sap-icon://action-settings" press=".onItemsPersonalize" />
      </OverflowToolbar>
    </headerToolbar>
    <columns>
      <Column width="3rem" visible="{itemsColumns>/rowAction}"><Text text="{i18n>colRowAction}" /></Column>
      <Column width="4rem" visible="{itemsColumns>/optOut}"><Text text="{i18n>colOptOutAncillary}" /></Column>
      <!-- Item # is a client-side-only placeholder (Detail.controller.js#_computeNextItemNumber), never sent to the backend - hidden in createMode so it doesn't read as a real assigned number. -->
      <Column width="4rem" visible="{= ${itemsColumns>/itemNumber} &amp;&amp; !${sectionFlags>/createMode} }"><Text text="{i18n>colItemNumber}" /></Column>
      <Column width="5rem" visible="{itemsColumns>/exisId}"><Text text="{i18n>colExisId}" /></Column>
      <Column width="8rem" visible="{itemsColumns>/brand}"><Text text="{i18n>colBrand}" /></Column>
      <Column width="10rem" visible="{itemsColumns>/ndcCode}"><Text text="{i18n>colNdcCode}" /></Column>
      <Column width="15rem" visible="{itemsColumns>/ndcDescription}"><Text text="{i18n>colNdcDescription}" /></Column>
      <Column width="6rem" hAlign="End" visible="{itemsColumns>/qty}"><Text text="{i18n>itemQty}" /></Column>
      <Column width="3rem" visible="{itemsColumns>/uom}"><Text text="{i18n>itemUom}" /></Column>
      <Column width="10rem" visible="{itemsColumns>/orderIntention}"><Text text="{i18n>colOrderIntention}" /></Column>
      <Column width="7rem" visible="{itemsColumns>/fundType}"><Text text="{i18n>colFundType}" /></Column>
      <Column width="7rem" visible="{itemsColumns>/poReference}"><Text text="{i18n>colPoReference}" /></Column>
      <Column width="7rem" visible="{itemsColumns>/deliveryStatus}"><Text text="{i18n>colDeliveryStatus}" /></Column>
      <Column width="6rem" hAlign="End" visible="{itemsColumns>/netValue}"><Text text="{i18n>itemNetAmount}" /></Column>
      <!-- Rejection Reason only ever applies to an already-existing order's items - meaningless in createMode. -->
      <Column width="10rem" visible="{= ${itemsColumns>/rejectionReason} &amp;&amp; !${sectionFlags>/createMode} }"><Text text="{i18n>colRejectionReason}" /></Column>
    </columns>
    <items>
      <ColumnListItem>
        <cells>
          <MenuButton text="" icon="sap-icon://menu2" type="Transparent" visible="{itemsColumns>/rowAction}">
            <menu>
              <Menu>
                <MenuItem text="{i18n>rowActionEdit}" enabled="false" />
                <MenuItem text="{i18n>rowActionDelete}" press=".onItemsDeleteRow"
                  enabled="{= ${sectionFlags>/items/editing} &amp;&amp; (!${sectionFlags>/createMode} || ${createState>/providerChosen}) }" />
                <!-- Fund Split (Trigger 2, design session prompt §3.3): enabled
                     whenever the row has ANY fund selected, same gate as the
                     Fund Type Select itself (createMode phasing) - SPL opens
                     edit mode, any other fund opens view mode (onItemsFundSplitPress). -->
                <MenuItem text="{i18n>rowActionFundSplit}" press=".onItemsFundSplitPress"
                  enabled="{= (!${sectionFlags>/createMode} || ${createState>/providerChosen}) &amp;&amp; !!${MaterialGroup2} }"
                  tooltip="{i18n>rowActionFundSplitTooltip}" />
              </Menu>
            </menu>
          </MenuButton>
          <CheckBox selected="{ZZ1_OptOutAncillary_SDI}" visible="{itemsColumns>/optOut}"
            enabled="{= !${sectionFlags>/createMode} || ${createState>/providerChosen} }" />
          <Text text="{SalesOrderItem}" visible="{= ${itemsColumns>/itemNumber} &amp;&amp; !${sectionFlags>/createMode} }" />
          <Input value="{PurchaseOrderByCustomer}" visible="{itemsColumns>/exisId}"
            enabled="{= !${sectionFlags>/createMode} || ${createState>/providerChosen} }" />
          <!-- Client requirement (2026-09-01): real field (ZZIndustryStandardName),
               carried over from the NDC's own IndustryStandardName on product
               selection (onItemNdcValueHelpRequest) - never typed in directly. -->
          <Text text="{ZZIndustryStandardName}" visible="{itemsColumns>/brand}" />
          <!-- CRUD Task 2: NDC stays editable only on a newly-added, not-yet-numbered row (Add Item), and only until a Product is chosen - existing/already-numbered items are always locked (late numbering: SalesOrderItem is empty until the create() is saved). One Input, not a Text/Input pair, so this cell always maps 1:1 to the ndcCode column. v5 UX phasing: also locked until a Provider is picked in createMode. -->
          <Input value="{Product}" visible="{itemsColumns>/ndcCode}"
            editable="{:= ${sectionFlags>/items/editing} &amp;&amp; !${SalesOrderItem} &amp;&amp; !${Product} &amp;&amp; (!${sectionFlags>/createMode} || ${createState>/providerChosen}) }"
            showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onItemNdcValueHelpRequest" />
          <Text text="{SalesOrderItemText}" visible="{itemsColumns>/ndcDescription}" />
          <Input value="{RequestedQuantity}" visible="{itemsColumns>/qty}"
            editable="{= ${sectionFlags>/items/editing} &amp;&amp; (!${sectionFlags>/createMode} || ${createState>/providerChosen}) }" type="Number" textAlign="End" change=".onProdQtyChange"/>
          <!-- Session Prompt (Detail View Adjustments) 3.7: reverted back to
               read-only - the prior editable Input (worked around a "Sales
               unit EA is not defined" SaveChanges error, see createPayloadUom
               comment history) is no longer needed now that
               onItemNdcValueHelpRequest auto-defaults this from the selected
               NDC's own Product.BaseUnit (ServiceSchema.productProperties.
               baseUnit) instead of always defaulting to the hardcoded "EA". -->
          <Text text="{RequestedQuantityUnit}" visible="{itemsColumns>/uom}" />
          <!-- MVGR1 - real MaterialGroup1 domain confirmed by the client (2026-09-16): ADU=Adult, PED=Pediatric, MIX=Pediatric and Adult (fits MaxLength=3). -->
          <Select selectedKey="{MaterialGroup1}" forceSelection="false" visible="{itemsColumns>/orderIntention}"
            enabled="{= !${sectionFlags>/createMode} || ${createState>/providerChosen} }" change=".onOrderIntentionChange">
            <core:Item key="ADU" text="Adult" />
            <core:Item key="PED" text="Pediatric" />
            <core:Item key="MIX" text="Adult, Pediatric" />
          </Select>
          <!-- MVGR2 - codes confirmed by the client (2026-08-31, matches MaterialGroup2's
               MaxLength=3). Items bound to the "fundTypes" model (Detail.controller.js#
               _createFundTypesModel); each entry's targetField drives the quantity mirror
               in onFundTypeChange. Per-Item enabled combines this row's own MaterialGroup1
               (Adult/Pediatric gating) with the model's pediatricOnly flag
               (formatter.fundTypeItemEnabled). Selecting SPL auto-opens the Fund Split
               dialog in edit mode (onFundTypeChange, Fund Split dialog session prompt). -->
          <Select selectedKey="{MaterialGroup2}" forceSelection="false" visible="{itemsColumns>/fundType}"
            enabled="{= !${sectionFlags>/createMode} || ${createState>/providerChosen} }"
            items="{fundTypes>/list}" change=".onFundTypeChange">
            <core:Item key="{fundTypes>key}" text="{fundTypes>text}"
              enabled="{parts: [{path: 'MaterialGroup1'}, {path: 'fundTypes>pediatricOnly'}, {path: 'fundTypes>disabled'}], formatter: '.formatter.fundTypeItemEnabled'}" />
          </Select>
          <Text text="{= '\u2014'}" visible="{itemsColumns>/poReference}" />
          <Text text="{_DeliveryStatus/DeliveryStatus_Text}" visible="{itemsColumns>/deliveryStatus}" />
          <ObjectNumber number="{NetAmount}" unit="{TransactionCurrency}" visible="{itemsColumns>/netValue}" />
          <Text text="{_SalesDocumentRjcnReason/SalesDocumentRjcnReason_Text}" visible="{= ${itemsColumns>/rejectionReason} &amp;&amp; !${sectionFlags>/createMode} }" />
        </cells>
      </ColumnListItem>
    </items>
  </Table>
</core:FragmentDefinition>
