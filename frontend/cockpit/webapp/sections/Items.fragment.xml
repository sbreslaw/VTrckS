<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <!-- CRUD Task 1 v3 (In-Place Create): the update group for this nested
       "_Item" navigation must match the header context's own group (edit
       session vs. transient create), which XML binding parameters can't
       express conditionally - no $$updateGroupId is declared here at all;
       Detail.controller.js#_rebindItemsGroup rebinds it (with the right
       literal group id) the first time this fragment's content loads, for
       both the "detail" and "create" routes. -->
  <Table id="itemsTable" items="{_Item}" growing="true" growingThreshold="20">
    <headerToolbar>
      <OverflowToolbar>
        <ToolbarSpacer />
        <Button text="{i18n>editAddItem}" icon="sap-icon://add" visible="{sectionFlags>/items/editing}"
          enabled="{= !${sectionFlags>/createMode} || ${createState>/providerChosen} }" press=".onItemsAddRow" />
        <Button text="{i18n>itemsExport}" icon="sap-icon://excel-attachment" press=".onItemsExport" />
        <Button text="{i18n>itemsPersonalize}" icon="sap-icon://action-settings" press=".onItemsPersonalize" />
      </OverflowToolbar>
    </headerToolbar>
    <columns>
      <Column width="3rem" visible="{itemsColumns>/rowAction}"><Text text="{i18n>colRowAction}" /></Column>
      <Column visible="{itemsColumns>/optOut}"><Text text="{i18n>colOptOutAncillary}" /></Column>
      <Column visible="{itemsColumns>/itemNumber}"><Text text="{i18n>colItemNumber}" /></Column>
      <Column visible="{itemsColumns>/exisId}"><Text text="{i18n>colExisId}" /></Column>
      <Column visible="{itemsColumns>/brand}"><Text text="{i18n>colBrand}" /></Column>
      <Column visible="{itemsColumns>/ndcCode}"><Text text="{i18n>colNdcCode}" /></Column>
      <Column visible="{itemsColumns>/ndcDescription}"><Text text="{i18n>colNdcDescription}" /></Column>
      <Column hAlign="End" visible="{itemsColumns>/qty}"><Text text="{i18n>itemQty}" /></Column>
      <Column visible="{itemsColumns>/uom}"><Text text="{i18n>itemUom}" /></Column>
      <Column visible="{itemsColumns>/orderIntention}"><Text text="{i18n>colOrderIntention}" /></Column>
      <Column visible="{itemsColumns>/fundType}"><Text text="{i18n>colFundType}" /></Column>
      <Column visible="{itemsColumns>/poReference}"><Text text="{i18n>colPoReference}" /></Column>
      <Column visible="{itemsColumns>/deliveryStatus}"><Text text="{i18n>colDeliveryStatus}" /></Column>
      <Column hAlign="End" visible="{itemsColumns>/netValue}"><Text text="{i18n>itemNetAmount}" /></Column>
      <Column visible="{itemsColumns>/rejectionReason}"><Text text="{i18n>colRejectionReason}" /></Column>
    </columns>
    <items>
      <ColumnListItem>
        <cells>
          <MenuButton text="" icon="sap-icon://overflow" type="Transparent" visible="{itemsColumns>/rowAction}">
            <menu>
              <Menu>
                <MenuItem text="{i18n>rowActionEdit}" enabled="false" />
                <MenuItem text="{i18n>rowActionDelete}" enabled="false" />
                <MenuItem text="{i18n>rowActionFundSplit}" enabled="false" />
              </Menu>
            </menu>
          </MenuButton>
          <CheckBox selected="{ZZ1_OptOutAncillary_SDI}" visible="{itemsColumns>/optOut}"
            enabled="{= !${sectionFlags>/createMode} || ${createState>/providerChosen} }" />
          <Text text="{SalesOrderItem}" visible="{itemsColumns>/itemNumber}" />
          <Input value="{PurchaseOrderByCustomer}" visible="{itemsColumns>/exisId}"
            enabled="{= !${sectionFlags>/createMode} || ${createState>/providerChosen} }" />
          <Text text="{= '\u2014'}" visible="{itemsColumns>/brand}" />
          <!-- CRUD Task 2: NDC stays editable only on a newly-added, not-yet-numbered row (Add Item), and only until a Product is chosen - existing/already-numbered items are always locked (late numbering: SalesOrderItem is empty until the create() is saved). One Input, not a Text/Input pair, so this cell always maps 1:1 to the ndcCode column. v5 UX phasing: also locked until a Provider is picked in createMode. -->
          <Input value="{Product}" visible="{itemsColumns>/ndcCode}"
            editable="{= ${sectionFlags>/items/editing} &amp;&amp; !${SalesOrderItem} &amp;&amp; !${Product} &amp;&amp; (!${sectionFlags>/createMode} || ${createState>/providerChosen}) }"
            showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onItemNdcValueHelpRequest" />
          <Text text="{SalesOrderItemText}" visible="{itemsColumns>/ndcDescription}" />
          <Input value="{RequestedQuantity}" visible="{itemsColumns>/qty}"
            editable="{= ${sectionFlags>/items/editing} &amp;&amp; (!${sectionFlags>/createMode} || ${createState>/providerChosen}) }" type="Number" textAlign="End" />
          <!-- ServiceSchema.createPayloadUom ("EA") is only a starting default (onItemsAddRow) -
               materials not maintained for EA reject at SaveChanges (RAP_SD_SLS_COMMON/007,
               "Sales unit EA is not defined for item..."), so this must be user-correctable. -->
          <Input value="{RequestedQuantityUnit}" visible="{itemsColumns>/uom}"
            editable="{= ${sectionFlags>/items/editing} &amp;&amp; (!${sectionFlags>/createMode} || ${createState>/providerChosen}) }" />
          <!-- MVGR1 - no fixed-values VH exposed by this service; temporary hardcoded options, mapping TBD. -->
          <Select selectedKey="{MaterialGroup1}" visible="{itemsColumns>/orderIntention}"
            enabled="{= !${sectionFlags>/createMode} || ${createState>/providerChosen} }">
            <core:Item key="Adult" text="Adult" />
            <core:Item key="Pediatric" text="Pediatric" />
            <core:Item key="AdultPediatric" text="Adult, Pediatric" />
          </Select>
          <!-- MVGR2 - no fixed-values VH exposed by this service; codes confirmed by the
               client (2026-08-31, matches MaterialGroup2's MaxLength=3). Adult vs Pediatric
               gating (VFC/CHP) per the client's stated sets; ARR/N/A have no stated gating
               rule so are left always-selectable, same as PAN (whose own auto-default source,
               the NDC's Pan indicator from Material Master, is not exposed by this service yet). -->
          <Select selectedKey="{MaterialGroup2}" visible="{itemsColumns>/fundType}"
            enabled="{= !${sectionFlags>/createMode} || ${createState>/providerChosen} }">
            <core:Item key="VFC" text="{i18n>enumFundTypeVfc}"
              enabled="{= ${MaterialGroup1} === 'Pediatric' || ${MaterialGroup1} === 'AdultPediatric' }" />
            <core:Item key="317" text="{i18n>enumFundType317}" />
            <core:Item key="S/L" text="{i18n>enumFundTypeState}" />
            <core:Item key="CHP" text="{i18n>enumFundTypeChip}"
              enabled="{= ${MaterialGroup1} === 'Pediatric' || ${MaterialGroup1} === 'AdultPediatric' }" />
            <core:Item key="SPL" text="{i18n>enumFundTypeSplit}" />
            <core:Item key="PAN" text="{i18n>enumFundTypePan}" />
            <core:Item key="ARR" text="{i18n>enumFundTypeArr}" />
            <core:Item key="N/A" text="{i18n>enumFundTypeNa}" />
          </Select>
          <Text text="{= '\u2014'}" visible="{itemsColumns>/poReference}" />
          <Text text="{_DeliveryStatus/DeliveryStatus_Text}" visible="{itemsColumns>/deliveryStatus}" />
          <ObjectNumber number="{NetAmount}" unit="{TransactionCurrency}" visible="{itemsColumns>/netValue}" />
          <Text text="{_SalesDocumentRjcnReason/SalesDocumentRjcnReason_Text}" visible="{itemsColumns>/rejectionReason}" />
        </cells>
      </ColumnListItem>
    </items>
  </Table>
</core:FragmentDefinition>
