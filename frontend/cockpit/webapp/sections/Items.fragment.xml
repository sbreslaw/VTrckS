<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <!-- CRUD Task 1 v3 (In-Place Create): the update group for this nested
       "_Item" navigation must match the header context's own group (edit
       session vs. transient create), which XML binding parameters can't
       express conditionally - no $$updateGroupId is declared here at all;
       Detail.controller.js#_rebindItemsGroup rebinds it (with the right
       literal group id) the first time this fragment's content loads, for
       both the "detail" and "create" routes.
       DF-1025: the Rejection Reason column shows in both modes; it is written
       only via bound actions (Computed property), never through this binding. -->
  <VBox width="100%">
    <OverflowToolbar class="detailItemsToolbar">
      <ToolbarSpacer />
      <Button text="{i18n>itemsExport}" icon="sap-icon://excel-attachment" press=".onItemsExport" />
      <Button text="{i18n>itemsPersonalize}" icon="sap-icon://action-settings" press=".onItemsPersonalize" />
    </OverflowToolbar>
    <VBox id="itemsViewport" class="detailItemsViewport">
    <Table id="itemsTable" width="100%" items="{_Item}" class="detailItemsTable" fixedLayout="true"
      updateFinished=".onItemsTableUpdateFinished">
    <columns>
      <Column width="2.5rem" visible="{itemsColumns>/rowAction}"><Text text="{i18n>colRowAction}" wrapping="true" /></Column>
      <Column width="4.75rem" visible="{itemsColumns>/optOut}">
        <VBox class="itemsOptOutHeader">
          <Text text="{i18n>colOptOutPrefix}" wrapping="false" />
          <Text text="{i18n>colOptOutSuffix}" wrapping="false" />
          <Text text="{i18n>colAncillary}" wrapping="true" />
        </VBox>
      </Column>
      <!-- §3.1: items now post to the sticky session immediately and get a real, backend-assigned SalesOrderItem - shown in createMode too now; the per-row cell (below) still hides it while the row's own create() is still in flight (@$ui5.context.isTransient). -->
      <Column width="3.5rem" visible="{itemsColumns>/itemNumber}"><Text text="{i18n>colItemNumber}" wrapping="true" /></Column>
      <Column width="4.5rem" visible="{itemsColumns>/exisId}"><Text text="{i18n>colExisId}" wrapping="true" /></Column>
      <Column width="4rem" visible="{itemsColumns>/brand}"><Text text="{i18n>colBrand}" wrapping="true" /></Column>
      <Column width="10rem" visible="{itemsColumns>/ndcCode}"><Text text="{i18n>colNdcCode}" wrapping="true" /></Column>
      <Column width="7rem" visible="{itemsColumns>/ndcDescription}"><Text text="{i18n>colNdcDescription}" wrapping="true" /></Column>
      <Column width="3.5rem" hAlign="End" visible="{itemsColumns>/qty}"><Text text="{i18n>itemQty}" wrapping="true" /></Column>
      <Column width="3rem" visible="{itemsColumns>/uom}"><Text text="{i18n>itemUom}" wrapping="true" /></Column>
      <Column width="4.5rem" visible="{itemsColumns>/orderIntention}"><VBox><Text text="{i18n>colOrder}" wrapping="false" /><Text text="{i18n>colIntention}" wrapping="false" /></VBox></Column>
      <Column width="4rem" visible="{itemsColumns>/fundType}"><Text text="{i18n>colFundType}" wrapping="true" /></Column>
      <Column width="5rem" visible="{itemsColumns>/poReference}"><VBox><Text text="{i18n>colPo}" wrapping="false" /><Text text="{i18n>colReference}" wrapping="false" /></VBox></Column>
      <Column width="4.5rem" visible="{itemsColumns>/deliveryStatus}"><VBox><Text text="{i18n>colDelivery}" wrapping="false" /><Text text="{i18n>colStatus}" wrapping="false" /></VBox></Column>
      <Column width="4.25rem" hAlign="End" visible="{itemsColumns>/netValue}"><VBox><Text text="{i18n>colNet}" wrapping="false" /><Text text="{i18n>colAmount}" wrapping="false" /></VBox></Column>
      <Column width="6.5rem" visible="{itemsColumns>/rejectionReason}"><VBox><Text text="{i18n>colRejection}" wrapping="false" /><Text text="{i18n>colReason}" wrapping="false" /></VBox></Column>
    </columns>
    <items>
      <ColumnListItem>
        <cells>
          <MenuButton text="" icon="sap-icon://menu2" type="Transparent" visible="{itemsColumns>/rowAction}">
            <menu>
              <Menu>
                <!-- Ancillary Items & Opt-Out session prompt §3.2: an
                     auto-inserted ancillary child row (HigherLevelItem set)
                     is fully read-only - no Edit navigation, no Fund Split
                     (it has no fund of its own to split). Delete is
                     deliberately left untouched below - children stay
                     manually deletable per §3.4. -->
                <MenuItem text="{i18n>rowActionEdit}" press=".onItemsEditPress"
                  enabled="{= ${sectionFlags>/items/editing} &amp;&amp; !${sectionFlags>/createMode} &amp;&amp; !${@$ui5.context.isTransient} &amp;&amp; !%{HigherLevelItem} }" />
                <MenuItem text="{i18n>rowActionDelete}" press=".onItemsDeleteRow"
                  enabled="{= ${sectionFlags>/items/editing} &amp;&amp; (!${sectionFlags>/createMode} || ${createState>/providerChosen}) }" />
                <!-- Fund Split (Trigger 2, design session prompt §3.3): enabled
                     whenever the row has ANY fund selected, same gate as the
                     Fund Type Select itself (createMode phasing) - SPL opens
                     edit mode, any other fund opens view mode (onItemsFundSplitPress). -->
                <MenuItem text="{i18n>rowActionFundSplit}" press=".onItemsFundSplitPress"
                  enabled="{= ${sectionFlags>/items/editing} &amp;&amp; (!${sectionFlags>/createMode} || ${createState>/providerChosen}) &amp;&amp; !!%{MaterialGroup2} &amp;&amp; !%{HigherLevelItem} }"
                  tooltip="{i18n>rowActionFundSplitTooltip}" />
              </Menu>
            </menu>
          </MenuButton>
          <!-- §3.3: the real opt-out flag (ZZ1_SKIPADDANC_SDI, NOT the
               unused ZZ1_OptOutAncillary_SDI - see ServiceSchema.js). Only
               enabled on a PARENT row that actually has ancillary children
               (itemsMeta>/childParents, keyed by SalesOrderItem - recomputed
               after every real-list load/refresh, see
               Detail.controller.js#_computeAncillaryParents); a child row
               itself never gets an opt-out control. -->
          <CheckBox selected="{ZZ1_SKIPADDANC_SDI}" select=".onItemOptOutChange"
            visible="{parts: [{path: 'itemsColumns>/optOut'}, {path: 'HigherLevelItem'}], formatter: '.formatter.itemOptOutVisible', useRawValues: true}"
            enabled="{parts: [
                {path: 'SalesOrderItem'},
                {path: 'HigherLevelItem'},
                {path: 'itemsMeta>/childParents'},
                {path: 'sectionFlags>/createMode'},
                {path: 'createState>/providerChosen'}
              ], formatter: '.formatter.itemOptOutEnabled', useRawValues: true}" />
          <!-- Item Number Link -> ItemDetail, mode=display (Session Prompt "Display/Edit
               Consistency" 4.4) - independent of /items/editing, works from both display
               and edit; a child (ancillary) row's link still navigates to its own
               read-only detail. -->
          <Link text="{SalesOrderItem}" visible="{= ${itemsColumns>/itemNumber} &amp;&amp; !${@$ui5.context.isTransient} }"
            press=".onItemNumberPress" />
          <Input value="{PurchaseOrderByCustomer}" visible="{itemsColumns>/exisId}"
            enabled="{= ${sectionFlags>/items/editing} &amp;&amp; (!${sectionFlags>/createMode} || ${createState>/providerChosen}) &amp;&amp; !!%{Product} &amp;&amp; !%{HigherLevelItem} &amp;&amp; ${orderUi>/columns/exisId/editable} !== false }" />
          <!-- Brand is authoritative from the selected Product. A scratch row
            cannot resolve _Product until it is posted, so the locally copied
            ZZIndustryStandardName only bridges that pre-POST interval.
            §3.2: indented for an ancillary child row (HigherLevelItem set). -->
          <Text text="{= (${HigherLevelItem} ? '    ' : '') + (${_Product/IndustryStandardName} || ${ZZIndustryStandardName} || '') }" visible="{itemsColumns>/brand}" />
          <!-- NDC is editable only until the row is posted (item number assigned); after that it is fixed. -->
          <Input value="{path: 'Product', mode: 'sap.ui.model.BindingMode.OneWay'}" visible="{itemsColumns>/ndcCode}"
            editable="{= ${sectionFlags>/items/editing} &amp;&amp; (!${sectionFlags>/createMode} || ${createState>/providerChosen}) &amp;&amp; !%{HigherLevelItem} &amp;&amp; !!${@$ui5.context.isTransient} &amp;&amp; ${orderUi>/columns/ndcCode/editable} !== false }"
            showValueHelp="true"
            showSuggestion="true" filterSuggests="false" startSuggestion="2"
            valueHelpRequest=".onItemNdcValueHelpRequest"
            suggest=".onItemNdcSuggest"
            suggestionItemSelected=".onItemNdcSuggestionSelected"
            change=".onItemNdcChange">
            <!-- Live-test (9-30-001 follow-up): suggestionItems is no longer
                 declared here - a static nested aggregation with an absolute
                 path polluted the outer _Item list's own $select (confirmed
                 live 404 on "Product_Text") - now bound lazily by
                 Detail.controller.js#onItemNdcSuggest on first use. -->
          </Input>
          <Text text="{= (${HigherLevelItem} ? '    ' : '') + (${SalesOrderItemText} || '') }" visible="{itemsColumns>/ndcDescription}" />
          <!-- value is OneWay - onProdQtyChange does its own explicit setProperty (so it
               gets a promise to await before refreshing the list for recalculated
               ancillary quantities); a two-way binding's own internal PATCH here would
               race that refresh exactly like the opt-out checkbox's did. -->
          <Input value="{path: 'RequestedQuantity', type: 'sap.ui.model.odata.type.Decimal', formatOptions: {maxFractionDigits: 0, preserveDecimals: false, groupingEnabled: false}, mode: 'sap.ui.model.BindingMode.OneWay'}" visible="{itemsColumns>/qty}"
            editable="{= ${sectionFlags>/items/editing} &amp;&amp; (!${sectionFlags>/createMode} || ${createState>/providerChosen}) &amp;&amp; !!%{Product} &amp;&amp; !%{HigherLevelItem} &amp;&amp; ${orderUi>/columns/qty/editable} !== false }" type="Number" textAlign="End" change=".onProdQtyChange"/>
          <!-- Session Prompt (Detail View Adjustments) 3.7: reverted back to
               read-only - the prior editable Input (worked around a "Sales
               unit EA is not defined" SaveChanges error, see createPayloadUom
               comment history) is no longer needed now that
               onItemNdcValueHelpRequest auto-defaults this from the selected
               NDC's own Product.BaseUnit (ServiceSchema.productProperties.
               baseUnit) instead of always defaulting to the hardcoded "EA". -->
          <Text text="{RequestedQuantityUnit}" visible="{itemsColumns>/uom}" />
          <!-- MVGR1: values from po>/OrderIntention, loaded once into the JSON "orderIntentions" model (Detail.controller.js#_loadOrderIntentionVH). -->
          <Select 
            selectedKey="{path: 'MaterialGroup1', 
            mode: 'sap.ui.model.BindingMode.OneWay'}" 
            forceSelection="false" 
            visible="{itemsColumns>/orderIntention}"
            items="{path: 'orderIntentions>/list', templateShareable: false}"
            editable="{= ${sectionFlags>/items/editing} &amp;&amp; (!${sectionFlags>/createMode} || ${createState>/providerChosen}) &amp;&amp; !!%{Product} &amp;&amp; !%{HigherLevelItem} &amp;&amp; ${orderUi>/columns/orderIntention/editable} !== false }" 
            change=".onOrderIntentionChange">
            <core:Item key="{orderIntentions>key}" text="{orderIntentions>text}" />
          </Select>
          <!-- MVGR2 remains MaterialGroup2. Each row binds its values lazily to
               po>/FundTypeVH, filtered by that row's NDC and Order Intention. -->
          <Select 
            selectedKey="{path: 'MaterialGroup2', mode: 'sap.ui.model.BindingMode.OneWay'}" 
            forceSelection="false" 
            visible="{itemsColumns>/fundType}"
            editable="{= ${sectionFlags>/items/editing} &amp;&amp; (!${sectionFlags>/createMode} || ${createState>/providerChosen}) &amp;&amp; !!%{Product} &amp;&amp; !!%{MaterialGroup1} &amp;&amp; !%{HigherLevelItem} &amp;&amp; ${orderUi>/columns/fundType/editable} !== false }"
            change=".onFundTypeChange" 
            modelContextChange=".onFundTypeModelContextChange" />
          <Text text="{= '\u2014'}" visible="{itemsColumns>/poReference}" />
          <Text text="{_DeliveryStatus/DeliveryStatus_Text}" visible="{itemsColumns>/deliveryStatus}" />
          <ObjectNumber number="{NetAmount}" unit="{TransactionCurrency}" visible="{itemsColumns>/netValue}" />
          <!-- DF-1025: SalesDocumentRjcnReason is Computed - selectedKey is OneWay (display
               only); writes go through the bound SetRejectionReason/RemoveRejectionReason
               actions in onItemRejectionReasonChange. Items come from the JSON
               "rejectionReasons" model: an absolute OData list nested in this row template
               would pollute _Item's autoExpandSelect $select. Existing-order edit mode
               invokes the bound action directly; create mode also honors its session's
               dynamic operation controls. -->
          <Select selectedKey="{path: 'SalesDocumentRjcnReason', mode: 'sap.ui.model.BindingMode.OneWay'}" forceSelection="false" width="100%"
            visible="{itemsColumns>/rejectionReason}"
            items="{rejectionReasons>/list}"
            editable="{= !!(${sectionFlags>/items/editing} &amp;&amp; (!${sectionFlags>/createMode} || ${createState>/providerChosen}) &amp;&amp; !${@$ui5.context.isTransient} &amp;&amp; !%{HigherLevelItem} &amp;&amp; (!${sectionFlags>/createMode} || %{__OperationControl/SetRejectionReason} || %{__OperationControl/RemoveRejectionReason}) &amp;&amp; ${orderUi>/columns/rejectionReason/editable} !== false) }"
            change=".onItemRejectionReasonChange">
            <core:Item key="{rejectionReasons>key}" text="{rejectionReasons>text}" />
          </Select>
        </cells>
      </ColumnListItem>
    </items>
    </Table>
    </VBox>
    <Button id="itemsAddMoreButton" text="{i18n>itemsAddMore}" width="100%" class="detailItemsAddMore"
      visible="{sectionFlags>/items/editing}"
      enabled="{= ${sectionFlags>/items/editing} &amp;&amp; (!${sectionFlags>/createMode} || ${createState>/providerChosen}) }"
      press=".onItemsAddMore" />
  </VBox>
</core:FragmentDefinition>
