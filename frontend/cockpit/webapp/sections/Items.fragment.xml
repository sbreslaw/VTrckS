<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Table items="{path: 'to_Item'}" growing="true" growingThreshold="20">
    <columns>
      <Column><Text text="{i18n>itemMaterial}" /></Column>
      <Column><Text text="{i18n>itemDescription}" /></Column>
      <Column><Text text="{i18n>itemCategory}" /></Column>
      <Column hAlign="End"><Text text="{i18n>itemQty}" /></Column>
      <Column><Text text="{i18n>itemUom}" /></Column>
      <Column visible="{view>/showFundTypeColumn}"><Text text="{i18n>itemFundType}" /></Column>
      <Column visible="{view>/showOrderIntentionColumn}"><Text text="{i18n>itemIntention}" /></Column>
      <Column hAlign="End"><Text text="{i18n>itemNetAmount}" /></Column>
    </columns>
    <items>
      <ColumnListItem>
        <cells>
          <Text text="{Material}" />
          <Text text="{SalesOrderItemText}" />
          <Text text="{SalesDocumentItemCategory}" />
          <ObjectNumber number="{RequestedQuantity}" />
          <Text text="{RequestedQuantityUnit}" />
          <Text text="{ZZ1_FUNDTYPE_SDI}" visible="{view>/showFundTypeColumn}" />
          <Text text="{ZZ1_ORDERINTENTION_SDI}" visible="{view>/showOrderIntentionColumn}" />
          <ObjectNumber number="{NetAmount}" unit="{TransactionCurrency}" />
        </cells>
      </ColumnListItem>
    </items>
  </Table>
</core:FragmentDefinition>
