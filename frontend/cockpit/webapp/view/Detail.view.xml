<mvc:View
  controllerName="cdc.vaccreq.controller.Detail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:core="sap.ui.core">
  <f:DynamicPage id="detailPage" fitContent="true">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading>
          <Title id="detailTitle" />
        </f:heading>
        <f:expandedContent>
          <HBox renderType="Bare" justifyContent="SpaceBetween" width="100%">
            <items>
              <HBox renderType="Bare" wrap="Wrap" width="80%">
                <items>
                  <ObjectStatus id="detailStatus" class="sapUiTinyMarginEnd" />
                  <Text id="detailCreatedOnBy" class="sapUiTinyMarginEnd" />
                  <ObjectNumber id="detailNetValue" />
                </items>
              </HBox>
              <OverflowToolbar>
                <ToolbarSpacer />
                <Button text="{i18n>close}" type="Transparent" press=".onCloseColumn" />
              </OverflowToolbar>
            </items>
          </HBox>
        </f:expandedContent>
        <f:actions>
          <Button text="{i18n>actionSave}" enabled="false" tooltip="{i18n>actionLaterTooltip}" />
          <Button text="{i18n>actionCancel}" enabled="false" tooltip="{i18n>actionLaterTooltip}" />
          <Button text="{i18n>actionNew}" enabled="false" tooltip="{i18n>actionLaterTooltip}" />
          <Button text="{i18n>actionCopy}" enabled="false" tooltip="{i18n>actionLaterTooltip}" />
          <Button text="{i18n>actionCreateReturn}" enabled="false" tooltip="{i18n>actionLaterTooltip}" />
          <Button text="{i18n>actionCreateReplacement}" enabled="false" tooltip="{i18n>actionLaterTooltip}" />
          <Button icon="sap-icon://print" text="{i18n>actionPreviewOutput}" press=".onPreviewOutput" />
          <Button icon="sap-icon://refresh" text="{i18n>actionRefresh}" press=".onRefresh" />
        </f:actions>
        <f:navigationActions>
          <Button
            id="messagePopoverBtn"
            icon="sap-icon://message-popup"
            text="{path: 'message>/', formatter: '.formatter.messagePopoverButtonText'}"
            type="{path: 'message>/', formatter: '.formatter.messagePopoverButtonType'}"
            press=".onMessagePopoverPress" />
          <Button text="{i18n>actionValidate}" press=".onValidate" />
        </f:navigationActions>
      </f:DynamicPageTitle>
    </f:title>

    <f:header>
      <f:DynamicPageHeader>
        <HBox wrap="Wrap" renderType="Bare" justifyContent="Start" items="{sectionsNav>/list}">
          <items>
            <Link text="{sectionsNav>title}" press=".onAnchorPress" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
              <customData>
                <core:CustomData key="panelId" value="{sectionsNav>id}" writeToDom="false" />
              </customData>
            </Link>
          </items>
        </HBox>
      </f:DynamicPageHeader>
    </f:header>

    <f:content>
      <VBox id="sectionsContainer" class="sapUiResponsiveContentPadding" />
    </f:content>
  </f:DynamicPage>
</mvc:View>
