<mvc:View
  controllerName="cdc.vaccreq.controller.Detail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:core="sap.ui.core">
  <f:DynamicPage id="detailPage" fitContent="true" preserveHeaderStateOnScroll="true"
    showFooter="{sectionFlags>/createMode}" class="detailObjectPage">
    <f:title>
      <f:DynamicPageTitle class="detailObjectPageTitle">
        <f:heading>
          <Title id="detailTitle" level="H1" class="detailObjectTitle" />
        </f:heading>
        <f:expandedContent>
          <HBox renderType="Bare" wrap="Wrap" alignItems="Center" class="detailHeaderFacts"
            visible="{= !${sectionFlags>/createMode} }">
            <items>
              <Text id="detailCreatedOnBy" class="detailHeaderFact" />
              <ObjectNumber id="detailNetValue" class="detailHeaderValue" />
            </items>
          </HBox>
        </f:expandedContent>

        <f:content>
          <HBox renderType="Bare" alignItems="Center" class="detailStatusRow">
            <GenericTag id="detailStatus"
              visible="{= !${sectionFlags>/createMode} }"
              design="Full">
           </GenericTag>
          </HBox>
        </f:content>

        <f:actions>
          <!-- Accessibility remediation (2026-11-06 review, package E): these 5
               actions have no backend/handler yet (future phase, see
               design/OPEN_QUESTIONS.md) - a permanently disabled Button with no
               way to ever become enabled is an accessibility dead-end (focusable
               but perpetually inert, or unreachable depending on AT/browser);
               hidden instead until the feature actually exists. -->
          <Button text="{i18n>actionSave}" visible="false" tooltip="{i18n>actionLaterTooltip}" />
          <Button text="{i18n>actionCancel}" visible="false" tooltip="{i18n>actionLaterTooltip}" />
          <Button id="newOrderBtn" text="{i18n>actionNew}" press=".onNewPress" />
          <Button text="{i18n>actionCopy}" visible="false" tooltip="{i18n>actionLaterTooltip}" />
          <Button text="{i18n>actionCreateReturn}" visible="false" tooltip="{i18n>actionLaterTooltip}" />
          <Button text="{i18n>actionCreateReplacement}" visible="false" tooltip="{i18n>actionLaterTooltip}" />
          <Button icon="sap-icon://print" text="{i18n>actionPreviewOutput}" press=".onPreviewOutput" visible="{= !${sectionFlags>/createMode} }" />
          <Button icon="sap-icon://refresh" text="{i18n>actionRefresh}" press=".onRefresh" visible="{= !${sectionFlags>/createMode} }" />
          <Button text="{i18n>actionValidate}" press=".onValidate" />
        </f:actions>
        <f:navigationActions>
          <Button
            id="messagePopoverBtn"
            icon="sap-icon://message-popup"
            text="{path: 'message>/', formatter: '.formatter.messagePopoverButtonText'}"
            type="{path: 'message>/', formatter: '.formatter.messagePopoverButtonType'}"
            press=".onMessagePopoverPress" />
          <Button id="enterFullScreen" icon="sap-icon://full-screen" type="Transparent" tooltip="{i18n>enterFullScreenTooltip}"
            visible="{= !${appView>/actionButtonsInfo/midColumn/fullScreen} }" press="toggleFullScreen" />
          <Button id="exitFullScreen" icon="sap-icon://exit-full-screen" type="Transparent" tooltip="{i18n>exitFullScreenTooltip}"
            visible="{= ${appView>/actionButtonsInfo/midColumn/fullScreen} }" press="toggleFullScreen" />
          <Button icon="sap-icon://decline" type="Transparent" tooltip="{i18n>close}" press=".onCloseColumn" />
        </f:navigationActions>
      </f:DynamicPageTitle>
    </f:title>

    <f:header>
      <f:DynamicPageHeader class="detailAnchorHeader">
        <HBox id="detailAnchorBar" wrap="NoWrap" renderType="Bare" justifyContent="Start" items="{sectionsNav>/list}" class="detailAnchorBar">
          <items>
              <Link text="{sectionsNav>title}" visible="{sectionsNav>visible}" press=".onAnchorPress" class="detailAnchorLink">
              <customData>
                <core:CustomData key="panelId" value="{sectionsNav>id}" writeToDom="false" />
              </customData>
            </Link>
          </items>
        </HBox>
      </f:DynamicPageHeader>
    </f:header>

    <f:content>
      <VBox id="sectionsContainer" class="detailSections sapUiResponsiveContentPadding" />
    </f:content>

    <f:footer>
      <OverflowToolbar class="detailCreateFooter">
        <ToolbarSpacer />
        <Button id="createSaveBtn" text="{i18n>actionSave}" type="Emphasized" press=".onCreateSavePress" />
        <Button id="createCancelBtn" text="{i18n>actionCancel}" press=".onCreateCancelPress" />
      </OverflowToolbar>
    </f:footer>
  </f:DynamicPage>
</mvc:View>
