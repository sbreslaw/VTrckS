<mvc:View
  controllerName="cdc.vaccreq.controller.Master"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:fb="sap.ui.comp.filterbar"
  xmlns:t="sap.ui.table"
  xmlns:rowmodes="sap.ui.table.rowmodes"
  xmlns:core="sap.ui.core">
  <f:DynamicPage id="masterPage" class="masterListPage" fitContent="false" headerExpanded="true" toggleHeaderOnTitleClick="true">
    <f:title>
      <f:DynamicPageTitle class="masterVariantTitle">
        <f:heading>
          <VariantManagement
            id="filterVariantManagement"
            selectedKey="*standard*"
            supportApplyAutomatically="false"
            supportDefault="false"
            supportFavorites="false"
            supportPublic="false"
            select=".onVariantSelect"
            save=".onVariantSave"
            manage=".onVariantManage"
            items="{variants>/items}">
            <items>
              <VariantItem
                key="{variants>key}"
                title="{variants>title}"
                changeable="{variants>changeable}"
                remove="{variants>remove}"
                rename="{variants>rename}" />
            </items>
          </VariantManagement>
        </f:heading>
      </f:DynamicPageTitle>
    </f:title>
    <f:header>
      <f:DynamicPageHeader class="masterFilterHeader" pinnable="true">
            <fb:FilterBar
              id="filterBar"
              class="masterSearchFilterBar"
              search=".onSearch"
              showFilterConfiguration="true"
              showClearOnFB="false"
              showRestoreOnFB="false"
              filterBarExpanded="true">
              <fb:filterGroupItems>
                <!-- Visible-in-bar group (Phase 2 Prompt v2, item B) -->
                <fb:FilterGroupItem name="providerPin" label="{i18n>filterProviderPin}" groupName="default" visibleInFilterBar="true">
                  <fb:control>
                    <MultiInput id="filterProviderPin" showValueHelp="true" valueHelpRequest=".onProviderPinValueHelpRequest" />
                  </fb:control>
                </fb:FilterGroupItem>
                <fb:FilterGroupItem name="requestId" label="{i18n>filterRequestId}" groupName="default" visibleInFilterBar="true">
                  <fb:control>
                    <MultiInput id="filterRequestId" showValueHelp="true" valueHelpRequest=".onConditionValueHelpRequest" />
                  </fb:control>
                </fb:FilterGroupItem>
                <fb:FilterGroupItem name="exisId" label="{i18n>filterExisId}" groupName="default" visibleInFilterBar="true">
                  <fb:control>
                    <MultiInput id="filterExisId" showValueHelp="true" valueHelpRequest=".onConditionValueHelpRequest" />
                  </fb:control>
                </fb:FilterGroupItem>
                <fb:FilterGroupItem name="provider" label="{i18n>filterProvider}" groupName="default" visibleInFilterBar="true">
                  <fb:control>
                    <MultiInput id="filterProvider" showValueHelp="true" valueHelpRequest=".onProviderFilterValueHelpRequest" />
                  </fb:control>
                </fb:FilterGroupItem>
                <fb:FilterGroupItem name="employeeResponsible" label="{i18n>filterEmployeeResponsible}" groupName="default" visibleInFilterBar="true">
                  <fb:control>
                    <Input id="filterEmployeeResponsible" />
                  </fb:control>
                </fb:FilterGroupItem>
                <fb:FilterGroupItem name="ndc" label="{i18n>filterNdc}" groupName="default" visibleInFilterBar="true">
                  <fb:control>
                    <MultiInput id="filterNdc" showValueHelp="true" valueHelpRequest=".onNdcFilterValueHelpRequest" />
                  </fb:control>
                </fb:FilterGroupItem>
                <!-- Optional: narrows to one of the category's READ-enabled types; Master.controller.js#_getOrderTypeFilter always applies the type scope. -->
                <fb:FilterGroupItem name="salesOrderType" label="{i18n>filterSalesOrderType}" groupName="default" visibleInFilterBar="true">
                  <fb:control>
                    <ComboBox id="filterSalesOrderType" showClearIcon="true" />
                  </fb:control>
                </fb:FilterGroupItem>

                <!-- Dialog-only group ("Filters" adapt dialog only) -->
                <fb:FilterGroupItem name="createdOn" label="{i18n>filterCreatedOn}" groupName="dialog" visibleInFilterBar="false">
                  <fb:control>
                    <DateRangeSelection id="filterCreatedOn" />
                  </fb:control>
                </fb:FilterGroupItem>
                <fb:FilterGroupItem name="contact" label="{i18n>filterContact}" groupName="dialog" visibleInFilterBar="false">
                  <fb:control>
                    <Input id="filterContact" />
                  </fb:control>
                </fb:FilterGroupItem>
                <fb:FilterGroupItem name="shipToParty" label="{i18n>filterShipToParty}" groupName="dialog" visibleInFilterBar="false">
                  <fb:control>
                    <Input id="filterShipToParty" />
                  </fb:control>
                </fb:FilterGroupItem>
                <fb:FilterGroupItem name="createdBy" label="{i18n>filterCreatedBy}" groupName="dialog" visibleInFilterBar="false">
                  <fb:control>
                    <Input id="filterCreatedBy" />
                  </fb:control>
                </fb:FilterGroupItem>
                <fb:FilterGroupItem name="status" label="{i18n>filterStatus}" groupName="dialog" visibleInFilterBar="false">
                  <fb:control>
                    <MultiComboBox id="filterStatus" />
                  </fb:control>
                </fb:FilterGroupItem>
                <fb:FilterGroupItem name="jurisdiction" label="{i18n>filterJurisdiction}" groupName="dialog" visibleInFilterBar="false">
                  <fb:control>
                    <Input id="filterJurisdiction" />
                  </fb:control>
                </fb:FilterGroupItem>
                <fb:FilterGroupItem name="priority" label="{i18n>filterPriority}" groupName="dialog" visibleInFilterBar="false">
                  <fb:control>
                    <ComboBox id="filterPriority" />
                  </fb:control>
                </fb:FilterGroupItem>
                <fb:FilterGroupItem name="deliveryBlockReason" label="{i18n>filterDeliveryBlockReason}" groupName="dialog" visibleInFilterBar="false">
                  <fb:control>
                    <ComboBox id="filterDeliveryBlockReason" />
                  </fb:control>
                </fb:FilterGroupItem>
                <fb:FilterGroupItem name="rejectionReason" label="{i18n>filterRejectionReason}" groupName="dialog" visibleInFilterBar="false">
                  <fb:control>
                    <Input id="filterRejectionReason" />
                  </fb:control>
                </fb:FilterGroupItem>
                <fb:FilterGroupItem name="maxHits" label="{i18n>filterMaxHits}" groupName="dialog" visibleInFilterBar="false">
                  <fb:control>
                    <Slider id="filterMaxHits" min="10" max="100" step="10" value="50" />
                  </fb:control>
                </fb:FilterGroupItem>
              </fb:filterGroupItems>
            </fb:FilterBar>
      </f:DynamicPageHeader>
    </f:header>
    <f:content>
      <VBox class="masterTableShell" renderType="Bare" width="100%">
        <t:Table
          id="requestsTable"
          class="masterResultsTable"
          selectionMode="None"
          alternateRowColors="false"
          columnHeaderHeight="32"
          enableColumnReordering="true"
          columnMove=".onColumnMove"
          columnResize=".onColumnResize"
          rowsUpdated=".onRowsUpdated"
          >
          <t:rowMode>
            <rowmodes:Fixed id="requestsRowMode" rowCount="10" rowContentHeight="32" />
          </t:rowMode>
          <t:noData>
            <IllustratedMessage
              illustrationType="sapIllus-NoSearchResults"
              title="{i18n>masterNoDataFoundTitle}"
              description="{= ${view>/masterHasSearch} ? ${i18n>masterNoDataFoundDescription} : ${i18n>masterNoDataBeforeSearch} }" />
          </t:noData>
          <t:extension>
            <OverflowToolbar class="masterTableToolbar">
              <Title text="{parts: ['i18n>masterTitle', 'orderContext>/title', 'view>/masterCount'], formatter: '.formatter.formatText'}" level="H3" />
              <ToolbarSpacer />
              <MenuButton text="{i18n>masterCreateButton}" type="Transparent">
                <menu>
                  <Menu items="{path: 'orderContext>/orderTypes', factory: '.createOrderTypeMenuItem'}" itemSelected=".onCreateRequest" />
                </menu>
              </MenuButton>
              <ToolbarSeparator />
              <SegmentedButton selectedKey="compact" selectionChange=".onMasterTableDensityChange">
                <items>
                  <SegmentedButtonItem key="cozy" icon="sap-icon://list" tooltip="{i18n>masterDensityCozy}" />
                  <SegmentedButtonItem key="compact" icon="sap-icon://table-view" tooltip="{i18n>masterDensityCompact}" />
                </items>
              </SegmentedButton>
              <Button
                icon="sap-icon://action-settings"
                type="Transparent"
                tooltip="{i18n>tablePersonalize}"
                press=".onMasterTablePersonalize" />
              <MenuButton
                icon="sap-icon://excel-attachment"
                type="Transparent"
                tooltip="{i18n>masterExport}">
                <menu>
                  <Menu>
                    <items>
                      <MenuItem text="{i18n>masterExport}" press=".onMasterExport" />
                      <MenuItem text="{i18n>masterExportAs}" press=".onMasterExportAs" />
                    </items>
                  </Menu>
                </menu>
              </MenuButton>
              <Select id="columnVariantSelect" visible="false" change=".onColumnVariantSelect" items="{columnVariants>/items}">
                <core:Item key="{columnVariants>key}" text="{columnVariants>text}" />
              </Select>
            </OverflowToolbar>
          </t:extension>
        </t:Table>
      </VBox>
    </f:content>
  </f:DynamicPage>
</mvc:View>
